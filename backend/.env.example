# Sentinel Backend Environment Configuration

# Supabase / PostgreSQL Connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinel

# Gemini AI API
GEMINI_API_KEY=your-gemini-api-key

# Telegram Bot API
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_MOCK_MODE=true
ALERT_RECIPIENT_CHAT_IDS=123456789,987654321
TELEGRAM_TEST_CHAT_ID=your-test-telegram-chat-id

# Upstash Redis Cache & Rate Limiting
UPSTASH_REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379

# Server Configuration (Optional)
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
